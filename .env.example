APP_NAME=AURUM
ENVIRONMENT=development
DEBUG=true

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-secret

DATABASE_URL=sqlite+aiosqlite:///./casino.db

SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=1209600
CSRF_COOKIE_NAME=csrf_token

STARTING_BALANCE=1000

# --- docker-compose (Postgres) only, ignored by local SQLite dev above ---
POSTGRES_USER=aurum
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=aurum
